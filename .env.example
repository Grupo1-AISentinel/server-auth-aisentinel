NODE_ENV=development
PORT=3069

# JWT Configuration
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
# El mismo valor debe estar en server-admin-aisentinel/.env
JWT_SECRET=replace-me-with-64-bytes-base64url
JWT_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=AuthService
JWT_AUDIENCE=AuthService

# Cloudinary (https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP (recomendado Gmail con App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=AI Sentinel App

# Database PostgreSQL (docker compose levanta el container en 5436)
DB_HOST=localhost
DB_PORT=5436
DB_NAME=DBAISentinel
DB_USER=root
DB_PASSWORD=change-me
DB_SQL_LOGGING=false

UPLOAD_PATH=./uploads

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# CORS allowed origins (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ADMIN_ALLOWED_ORIGINS=http://localhost:5173

# Internal API Token (debe coincidir con server-admin-aisentinel/.env)
# Generar con: node -e "console.log('aisentinel-' + require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_API_TOKEN=replace-me-with-random-hex

# Rate limit general (front-end)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# Rate limit auth (login, register, 2FA, forgot/reset)
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# Rate limit email
RATE_LIMIT_EMAIL_WINDOW_MS=900000
RATE_LIMIT_EMAIL_MAX_REQUESTS=3

# Verification Tokens (en horas)
VERIFICATION_EMAIL_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_HOURS=1
